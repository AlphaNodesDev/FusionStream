{
  "name": "fusion-stream",
  "version": "1.0.2",
  "description": "A Streaming App for Free Movies & Anime",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder",
    "start": "electron ."
  },
  "author": "Abhiram s",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AlphaNodesDev/FusionStream/issues"
  },
  "homepage": "https://github.com/AlphaNodesDev/FusionStream#readme",
  "devDependencies": {
    "electron": "^22.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.project.fusionstream",
    "productName": "FusionStream",
    "files": [
      "**/*"
    ],
    "asarUnpack": [
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "./license.txt",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "axios": "^1.8.4",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "cors-anywhere": "^0.4.4",
    "cross-fetch": "^4.1.0",
    "discord-rpc": "^4.0.1",
    "electron-store": "^10.0.1",
    "express": "^5.1.0",
    "fuse.js": "^7.1.0",
    "http-proxy-middleware": "^3.0.3",
    "leaflet": "^1.9.4",
    "punycode": "^2.3.1",
    "thepiratebay": "^1.4.8",
    "twilio": "^5.5.0"
  }
}
